{
  "name": "discord-server-backup",
  "version": "0.1.0",
  "private": true,
  "description": "One-time, portable Discord server archive exporter",
  "type": "module",
  "bin": {
    "discord-server-backup": "./dist/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
